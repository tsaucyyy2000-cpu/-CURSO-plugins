# Admin dashboard auth (required for /admin login)
# Generate:
#   node -e "const {randomBytes,scryptSync}=require('crypto'); const salt=randomBytes(16); const password=process.argv[1]; const hash=scryptSync(password,salt,64,{N:16384,r:8,p:1}); console.log('scrypt:16384:8:1:'+salt.toString('base64url')+':'+hash.toString('base64url'))" 'YourStrongPassword'
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:REPLACE_SALT:REPLACE_HASH
ADMIN_SESSION_SECRET=replace-with-long-random-string
# true on HTTPS hosts; false for local http://127.0.0.1
ADMIN_COOKIE_SECURE=false
